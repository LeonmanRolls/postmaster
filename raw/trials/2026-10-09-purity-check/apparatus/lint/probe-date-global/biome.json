{
  "root": true,
  "files": { "includes": ["scripts/**", "!scripts/fixtures/**"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": { "enabled": true, "rules": { "recommended": false } },
  "overrides": [
    {
      "includes": ["scripts/lib/**", "scripts/**/*-core.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": { "Date": "ambient clock", "performance": "ambient clock" }
              }
            }
          }
        }
      }
    }
  ]
}
